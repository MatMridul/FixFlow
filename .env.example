# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Chain order: gemini-3.8-flash -> gemini-3.5-flash-lite -> mistral-medium-latest -> mistral-small-latest
# Either key alone works; missing providers are skipped. No keys = offline extractor.
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional overrides
# LLM_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,mistral:mistral-medium-latest,mistral:mistral-small-latest
# LLM_TIMEOUT_S=6
# LLM_TOTAL_BUDGET_S=6.5
