# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Chain order: gemini-2.5-flash -> mistral-small-latest -> ministral-8b-latest -> groq openai/gpt-oss-120b
# Either key alone works; missing providers are skipped. No keys = offline extractor.
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Optional overrides
# LLM_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-2.5-flash,mistral:ministral-8b-latest
# LLM_TIMEOUT_S=7
# LLM_TOTAL_BUDGET_S=7.3
